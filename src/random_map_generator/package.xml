<?xml version="1.0"?>
<package format="3">
  <name>random_map_generator</name>
  <version>0.0.0</version>
  <description>
    Random obstacle and PGM map generator for Gazebo simulation.
    Dual-compatible with ROS1 (Noetic) and ROS2 (Humble+).
  </description>

  <maintainer email="sysuceo@todo.todo">sysuceo</maintainer>
  <license>MIT</license>

  <!-- Build tool: ament_cmake for colcon. catkin_make discovers packages by convention. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies available on BOTH ROS1 and ROS2 -->
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Platform-specific deps handled in CMakeLists.txt -->
  <!--   ROS1: rospy     (find_package in catkin branch) -->
  <!--   ROS2: rclcpp    (find_package in ament branch) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
