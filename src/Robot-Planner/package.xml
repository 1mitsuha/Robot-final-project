<?xml version="1.0"?>
<package format="3">
  <name>Robot-Planner</name>
  <version>0.0.0</version>
  <description>
    Robot-Planner: RRT* global path planning + PID trajectory tracking.
    Dual-compatible with ROS1 (Noetic) and ROS2 (Humble+).
  </description>

  <maintainer email="sysuceo@todo.todo">aditya</maintainer>
  <license>MIT</license>

  <!-- Build tool: ament_cmake (ROS2) + catkin (ROS1). Colcon uses <export><build_type>. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dependencies available on BOTH ROS1 and ROS2 -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Platform-specific deps handled in CMakeLists.txt -->
  <!--   ROS1: roscpp, rospy (find_package in catkin branch) -->
  <!--   ROS2: rclcpp, rclpy  (find_package in ament branch) -->

  <export>
  </export>
</package>
